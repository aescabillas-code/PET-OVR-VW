# --- MongoDB Atlas / API ---
# Copy this file to ".env" and put your real database user password in MONGODB_PASSWORD.
# (It is URL-encoded for you, so special characters like @ : / # are fine.)
MONGODB_URI=mongodb+srv://ariannekeiko18_db_user:<db_password>@arianne.zqcbypc.mongodb.net/
MONGODB_PASSWORD=LJ5QYRBrsv2IPHDq
MONGODB_DB=pet_station
PET_API_TOKEN=                # optional shared key; if set, also set it for Streamlit
PET_CORS_ORIGINS=*            # e.g. https://your-app.streamlit.app
PET_MAX_ASSET_MB=20

# --- Streamlit ---
# Leave PET_API_URL empty for a single-process setup: the API starts inside Streamlit (http://localhost:8000).
PET_API_URL=
PET_APP_PASSWORD=             # optional gate in front of the app
PET_EMBED_API=                # empty = auto (on when PET_API_URL is empty); 1 / 0 to force
