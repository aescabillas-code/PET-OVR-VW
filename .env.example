# --- MongoDB / API ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pet_station
PET_API_TOKEN=                # optional shared key; if set, also set it for Streamlit
PET_CORS_ORIGINS=*            # e.g. https://your-app.streamlit.app
PET_MAX_ASSET_MB=20

# --- Streamlit ---
PET_API_URL=http://localhost:8000     # address of the API as the BROWSER reaches it (use https in production)
PET_APP_PASSWORD=             # optional gate in front of the app
PET_EMBED_API=0               # 1 = run the API inside Streamlit (single-process setups)
